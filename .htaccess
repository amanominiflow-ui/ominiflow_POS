RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^wa-invoices/ofb-([0-9]+)-([0-9]+)-([a-fA-F0-9]+)\.pdf$ invoice-pdf.php?id=$1&b=$2&t=$3&ofb=1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^wa-invoices/([0-9]+)-([0-9]+)-([a-fA-F0-9]+)\.pdf$ invoice-pdf.php?id=$1&b=$2&t=$3 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^webhooks/razorpay/([A-Za-z0-9]+)/?$ webhooks/razorpay.php?token=$1 [QSA,L]

# Pretty public store URLs. Query-string URLs (store.php?slug=) still work if rewrite is off.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^store/([a-zA-Z0-9\-]+)/product/([0-9]+)/?$ store.php?slug=$1&page=product&id=$2 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^store/([a-zA-Z0-9\-]+)/(cart|checkout|thanks)/?$ store.php?slug=$1&page=$2 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^store/([a-zA-Z0-9\-]+)/?$ store.php?slug=$1 [QSA,L]
